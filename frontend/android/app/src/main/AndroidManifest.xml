<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.justorgyou.app">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="JustOrgYou"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"

        <!-- Security: Prevent backup of sensitive data -->
        android:allowBackup="false"
        android:fullBackupContent="false"

        <!-- Security: Use secure network -->
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"

        <!-- Security: Prevent screenshots in sensitive screens -->
        android:theme="@style/LaunchTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Deep linking (optional) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Security: Prevent activity from being visible in recent apps if needed -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>

        <!-- Don't delete the meta-data below. This is used by the Flutter tool -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
